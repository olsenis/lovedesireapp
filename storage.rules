rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Check if requesting user is a member of the given couple
    function isMemberOfCouple(coupleId) {
      let couple = firestore.get(/databases/(default)/documents/couples/$(coupleId));
      return couple != null && (
        couple.data.partner1Uid == request.auth.uid ||
        couple.data.partner2Uid == request.auth.uid
      );
    }

    // ── User profile photos ───────────────────────────────────────────────────
    // profile.jpg is intentionally readable by any authenticated user so partner
    // can see it (Firebase Storage rules can't do partner-only reads without a
    // Firestore lookup that requires setup, and profile photos aren't sensitive
    // enough to warrant that cost). Everything else under users/{uid}/ is
    // strictly self-only — closes the leak where a future feature dumping
    // sensitive files under users/{uid}/ would inherit the loose read rule.
    match /users/{uid}/profile.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Couple shared storage ─────────────────────────────────────────────────
    // Memories, Truth or Dare audio, flashes, moments — only couple members
    // can read/write. Write is size + content-type guarded to prevent a
    // custom-client attacker from bypassing client-side assertUnderLimit and
    // uploading arbitrarily large blobs (NV4 in Aug 2026 security review v2).
    //
    // 100 MB cap comfortably fits our largest legit payload (60 MB video
    // ceiling in storageService.assertUnderLimit) with headroom for future
    // features. Content-type limited to image/*, video/*, audio/* — no
    // application/octet-stream or arbitrary blob types. Reads stay unrestricted
    // by size/type so existing content keeps rendering.
    match /couples/{coupleId}/{allPaths=**} {
      allow read: if request.auth != null && isMemberOfCouple(coupleId);
      allow write: if request.auth != null
        && isMemberOfCouple(coupleId)
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*|audio/.*');
    }
  }
}
