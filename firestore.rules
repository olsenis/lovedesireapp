rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Returns true if the requesting user is a member of the given couple
    function isMemberOfCouple(coupleId) {
      let couple = get(/databases/$(database)/documents/couples/$(coupleId));
      return couple != null && (
        couple.data.partner1Uid == request.auth.uid ||
        couple.data.partner2Uid == request.auth.uid
      );
    }

    // Returns true if the requesting user is otherUid's current couple partner
    function isPartnerOf(otherUid) {
      let myCoupleId = get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('coupleId', '');
      return myCoupleId != '' &&
        (
          get(/databases/$(database)/documents/couples/$(myCoupleId)).data.partner1Uid == otherUid ||
          get(/databases/$(database)/documents/couples/$(myCoupleId)).data.partner2Uid == otherUid
        );
    }

    // ── Reports (H33 moderation) ─────────────────────────────────────────────
    // Top-level (NOT nested under /couples) so the couples wildcard rule
    // cannot grant partners read access to reports about them. Every read
    // and write goes through the `submitReport` / `adminGetReports` /
    // `adminResolveReport` callables in functions/src/index.ts, which use
    // the admin SDK (bypasses rules). Clients are blocked entirely.
    match /reports/{reportId} {
      allow read, create, update, delete: if false;
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Only the user themselves OR their current partner can read the profile.
      // Closes the leak where any authenticated user could read pushToken / birthday / etc.
      allow read: if request.auth != null && (
        request.auth.uid == uid || isPartnerOf(uid)
      );

      // User can write their own profile, but NOT isPremium — that field is set
      // server-side by the RevenueCat webhook (functions/src/index.ts). Without
      // this lock, any client could write isPremium: true and unlock the paid tier.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (
          !('isPremium' in request.resource.data)
          || request.resource.data.isPremium == resource.data.get('isPremium', false)
        );

      // Private subcollections: blueprint, consent, help, profile (birthday, push opt-in, etc.)
      // Strictly self-only.
      match /private/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Couples ───────────────────────────────────────────────────────────────
    match /couples/{coupleId} {
      // Read: existing members, OR the pending joiner while their pair
      // request is unresolved (needed for their waiting-screen snapshot
      // subscription in pairing.tsx).
      allow read: if request.auth != null && (
        resource.data.partner1Uid == request.auth.uid ||
        resource.data.partner2Uid == request.auth.uid ||
        resource.data.get('pendingPartner2Uid', null) == request.auth.uid
      );

      // Create: user must be setting themselves as partner1Uid
      allow create: if request.auth != null
        && request.resource.data.partner1Uid == request.auth.uid;

      // Update — Aug 2026 H22 pairing accept flow. Three client-side
      // paths are allowed; server (admin SDK) bypasses rules for the
      // pending-write that happens in `rateLimitedJoin`.
      //
      //   1. Existing member (partner1 or partner2) updates couple state
      //      as before (settings, LDR toggle, etc.). The isPremium diff
      //      guard still blocks the two subscription fields — those are
      //      RevenueCat-webhook-only.
      //   2. Existing member ACCEPTS a pending pair request — moves
      //      `pendingPartner2Uid` into whichever slot is empty and
      //      clears the pending fields.
      //   3. Existing member DECLINES a pending pair request — just
      //      clears the pending fields.
      //   4. Pending party CANCELS their own request — clears the
      //      pending fields; only the pendingPartner2Uid uid can do
      //      this.
      //
      // The old "non-member fills empty slot" path is removed — every
      // client-side slot fill now goes through the accept flow.
      allow update: if request.auth != null
        && (
          // (1) Existing member — general update
          isMemberOfCouple(coupleId)
          ||
          // (4) Pending party clearing their own request (cancel).
          // Restricted to ONLY the three pending-* fields so an attacker
          // who has become pendingPartner2Uid cannot self-assign
          // partner2Uid in the same update — the H22 accept flow is
          // supposed to require the existing member's explicit accept.
          // Without hasOnly the pending party could bypass H22 entirely.
          (
            resource.data.get('pendingPartner2Uid', null) == request.auth.uid
            && !request.resource.data.keys().hasAny(['pendingPartner2Uid'])
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['pendingPartner2Uid', 'pendingPartner2Name', 'pendingPartner2At'])
          )
        )
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['isPremium', 'premiumSince']);

      // ── Blueprint results: both partners can READ, only owner can WRITE ─────
      match /blueprints/{userId} {
        allow read: if request.auth != null && isMemberOfCouple(coupleId);
        allow write: if request.auth != null
          && request.auth.uid == userId
          && isMemberOfCouple(coupleId);
      }

      // ── Love Language results: same shape as blueprints (both read, owner-only write) ─────
      match /loveLanguages/{userId} {
        allow read: if request.auth != null && isMemberOfCouple(coupleId);
        allow write: if request.auth != null
          && request.auth.uid == userId
          && isMemberOfCouple(coupleId);
      }

      // Time Capsules feature was removed July 2026 — no rules block needed
      // for /timeCapsules/{id}. Any leftover pre-launch test data is cleaned
      // up by the GDPR cascade in functions/src/index.ts (still walks the
      // subcollection as a safety net).

      // ── Sunday Check-in: parent doc tracks completion, per-user answers gated ──
      // Parent doc (weekId metadata + completedAt map) is always readable so the
      // partner can see "they completed, waiting for me". Per-user answers live
      // in /entries/{uid} and are readable only by the owner OR by partner AFTER
      // both partners have completed. Prevents real-time peek at partner's draft.
      match /stateUnion/{weekId} {
        allow read: if isMemberOfCouple(coupleId);
        // Create is unrestricted for members — initial ensureStateUnionDoc()
        // writes {weekId, startedAt, completedAt: {}, answeredCount: {}}.
        allow create: if isMemberOfCouple(coupleId);
        // Update: prevent spoofing partner's completedAt / answeredCount to
        // unlock the /entries/{userId} read gate below. Only the requesting
        // uid's own key inside completedAt / answeredCount may be added or
        // changed. Other top-level fields (weekId, startedAt) stay locked.
        allow update: if isMemberOfCouple(coupleId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['completedAt', 'answeredCount'])
          && (
            !('completedAt' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.get('completedAt', {})
                 .diff(resource.data.get('completedAt', {}))
                 .affectedKeys().hasOnly([request.auth.uid])
          )
          && (
            !('answeredCount' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.get('answeredCount', {})
                 .diff(resource.data.get('answeredCount', {}))
                 .affectedKeys().hasOnly([request.auth.uid])
          );
        allow delete: if false;

        match /entries/{userId} {
          allow read: if isMemberOfCouple(coupleId) && (
            request.auth.uid == userId
            || (
              get(/databases/$(database)/documents/couples/$(coupleId)/stateUnion/$(weekId)).data.get('completedAt', {}).keys().hasAll([request.auth.uid, userId])
            )
          );
          allow create, update: if isMemberOfCouple(coupleId)
            && request.auth.uid == userId;
          allow delete: if false;
        }
      }

      // ── All other subcollections under a couple ────────────────────────────
      // Schema validation: prevent spoofing of identity fields.
      // Any document the caller creates with these fields MUST have them set to themselves.
      // Reads + updates + deletes remain available to either couple member.
      match /{subcollection}/{document=**} {
        allow read: if request.auth != null && isMemberOfCouple(coupleId);
        allow create: if request.auth != null
          && isMemberOfCouple(coupleId)
          && (!('fromUid'   in request.resource.data) || request.resource.data.fromUid   == request.auth.uid)
          // createdBy = auth.uid for user-authored docs. Auto-milestones in
          // Our Story write createdBy: "system" — allowed only when paired
          // with an autoKey (which distinguishes system-generated from
          // user-authored). See ensureAutoMilestone in services/milestoneService.ts.
          && (!('createdBy' in request.resource.data)
              || request.resource.data.createdBy == request.auth.uid
              || (request.resource.data.createdBy == 'system' && 'autoKey' in request.resource.data))
          && (!('loggedBy'  in request.resource.data) || request.resource.data.loggedBy  == request.auth.uid)
          && (!('sealedBy'  in request.resource.data) || request.resource.data.sealedBy  == request.auth.uid)
          && (!('uid'       in request.resource.data) || request.resource.data.uid       == request.auth.uid);
        // Updates: identity fields are immutable once set. Additionally, any
        // subcollection doc that carries a nested map keyed by uid — the
        // classic `answers` (Questions Game, WYR), `votes` (Daily Picks,
        // Fantasy Wishes), `discussed` (Questions Game) — is protected against
        // dot-path spoofing. Without this guard, a malicious client could send
        // `updateDoc(ref, { ['answers.' + partnerUid + '.7']: 'yes' })` and
        // forge partner's answer to trigger a fake reveal / fake match. The
        // stateUnion rules above already do this on parent-level completedAt;
        // this covers the couple-level game docs universally.
        //
        // Two legitimate patterns must survive:
        //  1. Caller writes to their own uid key only (submitAnswer, voteDailyWish).
        //  2. Caller clears the whole map for a reset (nextWYRQuestion, startWYR).
        // Both are allowed. Everything else is blocked.
        //
        // `scores` is deliberately NOT locked down — Truth or Dare's picker
        // legitimately awards a point to the challenged partner, so a caller
        // writing partner's score key is expected. Score inflation is a
        // gamification concern, not a data-integrity or privacy concern.
        allow update: if request.auth != null
          && isMemberOfCouple(coupleId)
          && (!('fromUid'   in resource.data) || request.resource.data.fromUid   == resource.data.fromUid)
          && (!('createdBy' in resource.data) || request.resource.data.createdBy == resource.data.createdBy)
          && (!('loggedBy'  in resource.data) || request.resource.data.loggedBy  == resource.data.loggedBy)
          && (!('sealedBy'  in resource.data) || request.resource.data.sealedBy  == resource.data.sealedBy)
          && (!('uid'       in resource.data) || request.resource.data.uid       == resource.data.uid)
          && (
            !('answers' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.get('answers', {}).size() == 0
            || request.resource.data.get('answers', {}).diff(resource.data.get('answers', {}))
                 .affectedKeys().hasOnly([request.auth.uid])
          )
          && (
            !('votes' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.get('votes', {}).size() == 0
            || request.resource.data.get('votes', {}).diff(resource.data.get('votes', {}))
                 .affectedKeys().hasOnly([request.auth.uid])
          )
          && (
            !('discussed' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.get('discussed', {}).size() == 0
            || request.resource.data.get('discussed', {}).diff(resource.data.get('discussed', {}))
                 .affectedKeys().hasOnly([request.auth.uid])
          )
          && (
            // Guess-partner-answer field added Aug 2026 when Versus merged
            // into Daily. Same per-uid nested-map guard as answers/votes/
            // discussed — caller can only write their own uid slot so
            // partner-guess spoofing is blocked at the rule layer.
            !('guesses' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.get('guesses', {}).size() == 0
            || request.resource.data.get('guesses', {}).diff(resource.data.get('guesses', {}))
                 .affectedKeys().hasOnly([request.auth.uid])
          );
        allow delete: if request.auth != null && isMemberOfCouple(coupleId);
      }
    }

    // ── Aggregate stats (Aug 2026) ────────────────────────────────────────
    // Anonymous per-month usage counter. Docs at /stats/{yyyy-mm} hold
    // integer counts per feature (screen_home, dare_created, etc). No uid,
    // no coupleId, no content — pure aggregate. See ADMIN_DASHBOARD.md.
    //
    // Client can only WRITE (via increment via merge:true from
    // services/statsService.ts). No reads from client — the admin
    // dashboard uses a Cloud Function callable to read, so users can
    // never see other users' event counts, aggregated or not.
    match /stats/{month} {
      allow read: if false;
      allow write: if request.auth != null;
    }

    // ── Active couples counter (Aug 2026) ──────────────────────────────────
    // Docs at /activeCouples/{yyyy-mm}/couples/{coupleId} exist iff that
    // couple used the app that month. Client can only write to their own
    // couple's doc (isMemberOfCouple gate). Admin dashboard counts docs
    // per-month for MAU / WAU. Never read from client. Payload now includes
    // `sessionCount` (incremented by telemetryService.writeSession per
    // session) to enable cheap per-couple leaderboard queries in the admin
    // dashboard via .orderBy('sessionCount', 'desc').limit(N).
    match /activeCouples/{month}/couples/{coupleId} {
      allow read: if false;
      allow write: if request.auth != null && isMemberOfCouple(coupleId);
    }
    match /activeCouples/{month} {
      // Parent doc unused; block direct client access.
      allow read, write: if false;
    }

    // ── Per-couple session records (Aug 2026) ──────────────────────────────
    // Layer 2 telemetry: one doc per screen mount → unmount with duration.
    // Powers per-screen min/max/avg and per-couple leaderboard in the admin
    // dashboard. Auto-deleted after 12 months by the scheduled Cloud
    // Function `cleanupOldSessions` (functions/src/index.ts).
    //
    // Client can only CREATE (via addDoc from telemetryService.writeSession)
    // and only for their own couple's coupleId. No reads, updates, or
    // deletes from client. Admin reads via admin SDK (adminGetSessionStats
    // / adminGetHeatmap callables) which bypass rules.
    //
    // See ADMIN_DASHBOARD.md § Phase 5 for the full data model.
    match /sessions/{month}/entries/{sessionId} {
      allow read: if false;
      allow create: if request.auth != null
        && isMemberOfCouple(request.resource.data.coupleId)
        && request.resource.data.durationSec is number
        && request.resource.data.durationSec >= 0
        && request.resource.data.durationSec <= 300;
      allow update, delete: if false;
    }
    match /sessions/{month} {
      allow read, write: if false;
    }
  }
}
