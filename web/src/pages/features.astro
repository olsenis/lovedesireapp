---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import StoreBadge from '../components/StoreBadge.astro';

const rituals = [
  { emoji: '🌅', title: 'Mood check-ins',
    body: "Tap one of 12 emojis to show how you're feeling. Your partner sees it on their home screen with a soft nudge when it changes. No words needed." },
  { emoji: '📅', title: 'Sunday Check-in',
    body: "Five questions each week. Neither of you sees the other's answers until you've both finished." },
  { emoji: '📸', title: 'Moments',
    body: "Your daily photo ritual. Take yours, your partner takes theirs, both reveal side-by-side. No filters, no likes." },
  { emoji: '💌', title: 'Love Notes',
    body: "Write notes that unlock on a specific date, or when your partner picks a certain mood. 'Open when you're sad' actually delivered when they need it." },
];

const games = [
  { emoji: '💫', title: 'Daily',
    body: "Three categories every day: Playful (free), Deep, and Spicy. Vote on picks, answer questions, matches surface when you both agree." },
  { emoji: '🎯', title: 'Truth or Dare',
    body: "Two ways to play. 'Together right here' spins a wheel on one phone. 'Wherever you are' runs turn-based across two phones with audio answers." },
  { emoji: '🤔', title: 'Would You Rather',
    body: "Both answer at the same time, then reveal. Three levels, level packs for themed evenings, best-ever score across sessions." },
  { emoji: '🃏', title: 'Activity Cards',
    body: "25 face-down cards, take turns picking one. Do it now, save to your Together List for later, or skip. Cards refresh monthly." },
  { emoji: '✨', title: 'Fantasy Wishes',
    body: "Double-blind voting on 400+ scenarios. You never see individual votes, only the ones you both said Yes to appear as matches." },
  { emoji: '🆚', title: 'Versus',
    body: "How well do you know your partner? Guess their answers to questions they've already answered. Unlocks once your partner has answered five or so binary questions in Daily." },
];

const insight = [
  { emoji: '🧬', title: 'The Lovers',
    body: "A 15-question quiz that maps you to one of five intimacy types: Feeling, Sexual, Spark, Kinky, Explorer. See your type, your partner's type, and how you fit together." },
  { emoji: '🫁', title: 'Sensate Focus',
    body: "Three guided mindful-touch sessions from sex therapy. Timer, rotating prompts, cycle tracking." },
  { emoji: '📊', title: 'Relationship Pulse',
    body: "A 10-question private satisfaction check. Take it monthly. Trend chart shows where you're growing and where you're slipping." },
  { emoji: '💭', title: 'Love Language',
    body: "Classic 10-question quiz. Your result lands on your partner's home screen as a rotating daily tip." },
];

const ldr = [
  { emoji: '🌍', title: 'Long Distance mode',
    body: "Partner's local time on your home screen, next-visit countdown, virtual date filter, LDR-tagged questions, and the Distance challenge program." },
  { emoji: '📸', title: 'Tease',
    body: "24-hour photos, videos, and voice notes. Gone by morning." },
  { emoji: '📝', title: 'Together List',
    body: "Shared todo across daily life, dates, intimacy, and goals. Matches from Fantasy Wishes and Activity Cards land here for later." },
];
---

<BaseLayout
  title="Features, Love Desire"
  description="Rituals, games, insight tools, and long-distance features for two."
>
  <!-- Page hero -->
  <section class="max-w-6xl mx-auto px-6 pt-20 pb-12 text-center">
    <p class="text-xs uppercase tracking-[0.35em] text-muted font-bold mb-3">Features</p>
    <h1 class="font-heading text-5xl md:text-6xl leading-tight text-burgundy">
      Rituals, games,<br />
      and quiet insight tools.
    </h1>
  </section>

  <!-- Rituals -->
  <section class="max-w-6xl mx-auto px-6 pb-16">
    <p class="text-xs uppercase tracking-[0.35em] text-muted font-bold mb-6">Rituals</p>
    <div class="grid md:grid-cols-2 gap-6">
      {rituals.map(f => (
        <FeatureCard emoji={f.emoji} title={f.title} body={f.body} accent="blush" />
      ))}
    </div>
  </section>

  <!-- Games -->
  <section class="max-w-6xl mx-auto px-6 pb-16">
    <p class="text-xs uppercase tracking-[0.35em] text-muted font-bold mb-6">Play together</p>
    <div class="grid md:grid-cols-2 gap-6">
      {games.map(f => (
        <FeatureCard emoji={f.emoji} title={f.title} body={f.body} accent="rose" />
      ))}
    </div>
  </section>

  <!-- Insight -->
  <section class="max-w-6xl mx-auto px-6 pb-16">
    <p class="text-xs uppercase tracking-[0.35em] text-muted font-bold mb-6">Understand each other</p>
    <div class="grid md:grid-cols-2 gap-6">
      {insight.map(f => (
        <FeatureCard emoji={f.emoji} title={f.title} body={f.body} accent="burgundy" />
      ))}
    </div>
  </section>

  <!-- LDR + more -->
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <p class="text-xs uppercase tracking-[0.35em] text-muted font-bold mb-6">Long distance and more</p>
    <div class="grid md:grid-cols-3 gap-6">
      {ldr.map(f => (
        <FeatureCard emoji={f.emoji} title={f.title} body={f.body} accent="blush" />
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-border">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28 text-center flex flex-col items-center gap-6">
      <h2 class="font-heading text-4xl md:text-5xl text-burgundy max-w-2xl leading-tight">
        Ready to try it?
      </h2>
      <div class="pt-2">
        <StoreBadge />
      </div>
    </div>
  </section>
</BaseLayout>
