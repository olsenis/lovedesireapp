---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreBadge from '../components/StoreBadge.astro';

const faqs = [
  {
    q: "How do we pair as a couple?",
    a: "After signing up, one of you generates a 6-digit invite code in the Pairing screen. Share it with your partner however you'd normally message them (text, in person, WhatsApp). They enter the code on their end and you're paired. No public profiles, no swiping.",
  },
  {
    q: "What can my partner see?",
    a: "Anything you both share deliberately: mood, moments, notes, matches from games, your name and profile photo. Private things stay private. Fantasy Wishes votes are double-blind (they only see matches), your Relationship Pulse score is only for you, Journal entries are private unless you deliberately share.",
  },
  {
    q: "Is Love Desire safe?",
    a: "All data is transmitted over encrypted HTTPS. Firestore security rules ensure only your couple can access your data. Passwords are hashed by Firebase Authentication and never stored in plain text. Photos live in Firebase Storage with strict access controls. We don't use analytics SDKs, ad networks, or tracking tools.",
  },
  {
    q: "One subscription covers both partners, really?",
    a: "Really. If either of you subscribes, both of you unlock every paid feature. Subscription lives on the couple, not the individual user. No per-user pricing games.",
  },
  {
    q: "How much does it cost?",
    a: "The free tier is enough for daily use: mood, Moments, Sunday Check-in, Love Notes, Playful Daily, Truth or Dare (Sweet + Flirty), Would You Rather (Playful + Romantic), Tonight's Date, and long-distance mode. Premium unlocks Deep and Spicy content, Fantasy Wishes, Activity Cards, The Lovers, Sensate Focus, and Fire and Desire challenges. Pricing details will be announced with launch.",
  },
  {
    q: "How do I cancel?",
    a: "Cancel through the App Store (iOS) or the marketing website's Android page (Android), same place you started the subscription. Your premium access continues until the end of the current billing period.",
  },
  {
    q: "Is Love Desire an 18+ app?",
    a: "Yes. When you sign up you confirm you're 18+. Declining the confirmation deletes the account immediately, no bypass. Explicit content sits behind both the age attestation and the paid subscription, so it never surfaces for anyone who hasn't opted in.",
  },
  {
    q: "Does it work over long distance?",
    a: "Yes, it's built with LDR in mind. Toggle Long Distance in Profile and you get your partner's local time on the home screen, next-visit countdown, virtual date filter, LDR-tagged questions, pre-visit and post-visit hype nudges, care package reminders, and the Distance program in the 30-Day Challenge.",
  },
  {
    q: "What if my partner and I break up?",
    a: "Any of you can Disconnect from partner in Profile (one tap, immediate). The couple bond ends and each partner keeps their own account. Shared data (Notes, Moments, Memories) stays hidden after disconnect. You can re-pair with a different partner using a fresh invite code.",
  },
  {
    q: "Do I get all my data if I delete my account?",
    a: "You can request an export of your data by emailing us at support@lovedesireapp.com. Account deletion removes your personal data (name, email, profile photo, birthday) immediately. Shared couple data may persist until your partner also deletes, since it's jointly owned. GDPR rights apply for European users.",
  },
  {
    q: "Is Love Desire on Google Play?",
    a: "No. Android is distributed via signed APK on our marketing site. Sideload after enabling 'Install from this source' in your Android settings. The in-app update prompt checks the latest version automatically. Same features as iOS, no split build.",
  },
  {
    q: "What if we're a same-sex couple?",
    a: "The app is written for two people who chose each other, full stop. Copy, imagery, and content are gender-neutral where relevant and inclusive across formats where they aren't.",
  },
  {
    q: "Do you have a Discord or community?",
    a: "Not yet. Love Desire is intentionally a 1:1 app, no public feed, no community features. If you want to reach us, email is the fastest way.",
  },
  {
    q: "What if the app has a bug?",
    a: "Email support@lovedesireapp.com with a description of what happened. If it's a critical issue we usually push a fix within a day or two.",
  },
  {
    q: "Is our couple data used to train AI?",
    a: "No. We don't use your data for AI training, advertising, or profiling. Firebase (our infrastructure provider) processes data on our behalf under a data processing agreement, they can't use your data either.",
  },
];
---

<BaseLayout
  title="FAQ, Love Desire"
  description="Answers to common questions about pairing, privacy, subscription, and long distance."
>
  <section class="max-w-4xl mx-auto px-6 pt-20 pb-12 text-center">
    <p class="text-xs uppercase tracking-[0.35em] text-muted font-bold mb-3">Frequently asked</p>
    <h1 class="font-heading text-5xl md:text-6xl leading-tight text-burgundy">
      Ask away.
    </h1>
  </section>

  <section class="max-w-3xl mx-auto px-6 pb-20 flex flex-col gap-4">
    {faqs.map(({ q, a }) => (
      <details class="group bg-cream border border-border rounded-2xl p-6 open:bg-blush transition-colors">
        <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
          <h3 class="font-heading text-xl text-burgundy leading-snug">{q}</h3>
          <span class="text-burgundy font-bold text-2xl transition-transform group-open:rotate-45 leading-none pt-1">+</span>
        </summary>
        <p class="text-burgundy/85 leading-relaxed text-sm mt-4">{a}</p>
      </details>
    ))}
  </section>

  <section class="border-t border-border">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-24 text-center flex flex-col items-center gap-6">
      <h2 class="font-heading text-4xl md:text-5xl text-burgundy max-w-xl leading-tight">
        Still have questions?
      </h2>
      <p class="text-burgundy/80">Email us at <a href="mailto:support@lovedesireapp.com" class="underline">support@lovedesireapp.com</a></p>
      <div class="pt-4">
        <StoreBadge />
      </div>
    </div>
  </section>
</BaseLayout>
