---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import StoreBadge from '../components/StoreBadge.astro';
---

<BaseLayout title="Love Desire">
  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-6 pt-20 pb-16 md:pt-28 md:pb-24 grid md:grid-cols-2 gap-12 md:gap-16 items-center">
    <div class="flex flex-col gap-6">
      <p class="text-xs uppercase tracking-[0.35em] text-muted font-bold">A private app for two</p>
      <h1 class="font-heading text-5xl md:text-6xl leading-tight text-burgundy">
        Two of you.<br />
        <em class="font-normal">One app</em>.
      </h1>
      <p class="text-lg text-burgundy/80 leading-relaxed max-w-md">
        Rituals for the week, questions for the night, games for the weekend. Only the two of you can see any of it.
      </p>
      <div class="pt-2">
        <StoreBadge />
      </div>
      <p class="text-xs text-muted italic mt-2">One subscription covers both partners.</p>
    </div>

    <!-- Hero visual, hand-crafted quote card until app screenshots ship.
         Design intent: cream card with the app's Cormorant wordmark +
         a single quiet reflection line. Matches the mobile splash overlay
         so social sharers see continuity. Swap for real screenshot mockups
         before App Store submit. -->
    <div class="relative aspect-[9/16] max-w-sm mx-auto md:mx-0 md:ml-auto rounded-[2.5rem] overflow-hidden bg-gradient-to-br from-blush via-cream to-blush shadow-2xl border border-rose/30">
      <div class="absolute inset-0 flex flex-col items-center justify-center p-10 gap-4">
        <p class="font-heading text-burgundy text-5xl text-center leading-none">Love Desire</p>
        <p class="text-rose text-xl">♥</p>
        <p class="font-heading text-burgundy/70 text-xl text-center italic leading-snug mt-4">
          "Two of you.<br />One private space."
        </p>
      </div>
    </div>
  </section>

  <!-- Top 3 features -->
  <section class="max-w-6xl mx-auto px-6 pb-20 md:pb-28">
    <div class="max-w-2xl mx-auto text-center mb-14">
      <p class="text-xs uppercase tracking-[0.35em] text-muted font-bold mb-3">What's inside</p>
      <h2 class="font-heading text-4xl md:text-5xl text-burgundy">Three ways to feel close.</h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <FeatureCard
        emoji="🌅"
        title="Daily rhythm"
        body="Mood taps, a shared daily photo, and the Sunday Check-in."
        accent="blush"
      />
      <FeatureCard
        emoji="🎯"
        title="Playful games"
        body="Truth or Dare, Would You Rather, Fantasy Wishes, Activity Cards. Two phones, real-time, no scoreboard."
        accent="rose"
      />
      <FeatureCard
        emoji="🫂"
        title="Quiet insight"
        body="The Lovers intimacy quiz, Presence slow-touch practice, Love Language, and Our Story timeline. For the slower conversations."
        accent="burgundy"
      />
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="border-t border-border">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28 text-center flex flex-col items-center gap-6">
      <p class="text-xs uppercase tracking-[0.35em] text-muted font-bold">Ready?</p>
      <h2 class="font-heading text-4xl md:text-5xl text-burgundy max-w-2xl leading-tight">
        Pair up. It takes a minute.
      </h2>
      <div class="pt-2">
        <StoreBadge />
      </div>
    </div>
  </section>
</BaseLayout>
